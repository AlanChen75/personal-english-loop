{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AlanChen75/personal-english-loop/main/progress/weekly-summary.schema.json",
  "title": "Personal English Loop Weekly Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "week_id",
    "generated_at",
    "timezone",
    "source_note",
    "session_ids",
    "coverage",
    "score_summary",
    "recurring_issues",
    "chunk_changes",
    "material_effectiveness",
    "evidence_gaps",
    "proposed_adjustments",
    "curriculum_action",
    "discussion_questions"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "week_id": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "timezone": {"const": "Asia/Taipei"},
    "source_note": {"type": "string", "minLength": 1},
    "session_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[A-F][0-9]{2}-[0-9]{4}$"
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_count", "total_minutes", "lesson_ids", "modes", "material_ids"],
      "properties": {
        "session_count": {"type": "integer", "minimum": 0},
        "total_minutes": {"type": "integer", "minimum": 0},
        "lesson_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "modes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "material_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "score_summary": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["average", "observed_count", "trend"],
        "properties": {
          "average": {"type": ["number", "null"], "minimum": 1, "maximum": 5},
          "observed_count": {"type": "integer", "minimum": 0},
          "trend": {"enum": ["improved", "stable", "declined", "insufficient_data"]}
        }
      }
    },
    "recurring_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recurrence_key", "type", "session_count", "evidence_session_ids", "status"],
        "properties": {
          "recurrence_key": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "session_count": {"type": "integer", "minimum": 1},
          "evidence_session_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "status": {"enum": ["resolved", "improving", "open"]}
        }
      }
    },
    "chunk_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chunk", "from_status", "to_status", "evidence_session_ids"],
        "properties": {
          "chunk": {"type": "string", "minLength": 1},
          "from_status": {"enum": ["not_seen", "new", "practicing", "comfortable"]},
          "to_status": {"enum": ["new", "practicing", "comfortable"]},
          "evidence_session_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "material_effectiveness": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["material_id", "use_count", "observed_effect", "evidence_session_ids"],
        "properties": {
          "material_id": {"type": "string", "minLength": 1},
          "use_count": {"type": "integer", "minimum": 1},
          "observed_effect": {"enum": ["helpful", "neutral", "difficult", "insufficient_data"]},
          "evidence_session_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "evidence_gaps": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "proposed_adjustments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "action", "target", "reason", "evidence_session_ids"],
        "properties": {
          "priority": {"enum": ["high", "medium", "low"]},
          "action": {"enum": ["keep", "repeat", "simplify", "expand", "replace", "add"]},
          "target": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "evidence_session_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "curriculum_action": {"enum": ["no_change", "discuss_revision", "ready_for_next_lesson"]},
    "discussion_questions": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
