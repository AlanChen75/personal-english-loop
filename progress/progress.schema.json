{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AlanChen75/personal-english-loop/main/progress/progress.schema.json",
  "title": "Personal English Loop Session Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "recorded_at",
    "timezone",
    "source",
    "lesson",
    "practice_minutes",
    "materials",
    "practice_events",
    "scores",
    "issues",
    "chunk_progress",
    "self_assessment",
    "coach_summary",
    "next_plan"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "session_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[A-F][0-9]{2}-[0-9]{4}$"
    },
    "recorded_at": {"type": "string", "format": "date-time"},
    "timezone": {"const": "Asia/Taipei"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "conversation_title", "coach_version"],
      "properties": {
        "channel": {
          "enum": ["chatgpt_mobile", "chatgpt_web", "chatgpt_desktop", "codex", "manual"]
        },
        "conversation_title": {"type": "string", "minLength": 1},
        "coach_version": {"type": "string", "minLength": 1}
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lesson_id", "title", "day", "source_url", "course_git_ref"],
      "properties": {
        "lesson_id": {"type": "string", "pattern": "^[A-F][0-9]{2}$"},
        "title": {"type": "string", "minLength": 1},
        "day": {"type": "integer", "minimum": 1},
        "source_url": {"type": "string", "format": "uri"},
        "course_git_ref": {"type": "string", "minLength": 1}
      }
    },
    "practice_context": {
      "enum": ["driving", "parked", "home", "office", "other", "unknown"]
    },
    "practice_minutes": {"type": "integer", "minimum": 1, "maximum": 180},
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["material_id", "material_type", "title", "completed", "repetitions"],
        "properties": {
          "material_id": {"type": "string", "minLength": 1},
          "material_type": {
            "enum": [
              "lesson",
              "transcript",
              "audio_slow",
              "audio_natural",
              "audio_listen_repeat",
              "audio_qa",
              "audio_commute_pack",
              "chunks",
              "vocabulary",
              "role_play",
              "custom"
            ]
          },
          "title": {"type": "string", "minLength": 1},
          "url": {"type": ["string", "null"], "format": "uri"},
          "completed": {"type": "boolean"},
          "repetitions": {"type": "integer", "minimum": 0}
        }
      }
    },
    "practice_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "activity", "material_ids", "prompt_or_task", "result", "issue_ids"],
        "properties": {
          "event_id": {"type": "string", "pattern": "^E[0-9]{2}$"},
          "activity": {"enum": ["listen", "repeat", "qa", "role_play", "free_talk", "review"]},
          "material_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "prompt_or_task": {"type": "string", "minLength": 1},
          "learner_response_excerpt": {"type": ["string", "null"], "maxLength": 500},
          "result": {"enum": ["independent", "self_corrected", "with_hint", "after_model", "not_completed"]},
          "response_start_seconds": {"type": ["number", "null"], "minimum": 0, "maximum": 120},
          "issue_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^I[0-9]{2}$"}
          }
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comprehension", "response_speed", "clarity", "confidence", "pronunciation"],
      "properties": {
        "comprehension": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "response_speed": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "clarity": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "confidence": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "pronunciation": {"type": ["integer", "null"], "minimum": 1, "maximum": 5}
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id",
          "recurrence_key",
          "type",
          "target",
          "observed_excerpt",
          "correction",
          "reason",
          "support_level",
          "status"
        ],
        "properties": {
          "issue_id": {"type": "string", "pattern": "^I[0-9]{2}$"},
          "recurrence_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
          "type": {
            "enum": [
              "comprehension",
              "pronunciation",
              "grammar",
              "vocabulary",
              "fluency",
              "response_speed",
              "confidence",
              "content_difficulty"
            ]
          },
          "target": {"type": "string", "minLength": 1},
          "observed_excerpt": {"type": "string", "maxLength": 500},
          "correction": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "support_level": {"enum": ["none", "repetition", "chunk", "first_word", "model_answer"]},
          "status": {"enum": ["resolved", "improving", "open"]}
        }
      }
    },
    "chunk_progress": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chunk", "attempts", "successful_attempts", "status", "issue_ids"],
        "properties": {
          "chunk": {"type": "string", "minLength": 1},
          "attempts": {"type": "integer", "minimum": 0},
          "successful_attempts": {"type": "integer", "minimum": 0},
          "status": {"enum": ["new", "practicing", "comfortable"]},
          "issue_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^I[0-9]{2}$"}
          }
        }
      }
    },
    "new_words": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["word", "simple_meaning", "status"],
        "properties": {
          "word": {"type": "string", "minLength": 1},
          "simple_meaning": {"type": "string", "minLength": 1},
          "status": {"enum": ["new", "practicing", "comfortable"]}
        }
      }
    },
    "self_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["difficulty", "confidence", "note"],
      "properties": {
        "difficulty": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "confidence": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "note": {"type": "string"}
      }
    },
    "coach_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wins", "priority_issue_ids", "evidence_limitations"],
      "properties": {
        "wins": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "priority_issue_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^I[0-9]{2}$"}
        },
        "evidence_limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "next_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "target_chunks", "target_issue_ids", "recommended_activities", "ready_for_next_lesson"],
      "properties": {
        "goal": {"type": "string", "minLength": 1},
        "target_chunks": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "target_issue_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^I[0-9]{2}$"}
        },
        "recommended_activities": {
          "type": "array",
          "items": {"enum": ["listen", "repeat", "qa", "role_play", "free_talk", "review"]}
        },
        "ready_for_next_lesson": {"type": "boolean"}
      }
    }
  }
}
